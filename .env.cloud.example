# Store actual secrets in Render Environment or an ignored .env.cloud file.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/tmp/supabase-ca.crt
STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=SERVER_ONLY_SECRET_KEY
SESSION_HTTPS_ONLY=true
SESSION_SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
# Optional; use a newly generated admin password, never the local example.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Render Environment: paste the project DB CA certificate as multiline PEM.
SUPABASE_DB_CA_CERT=
