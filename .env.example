# =========================================================================
# 【環境變數範本檔】請複製此檔案並重新命名為 `.env`，再根據個人本機環境修改數值
# =========================================================================

# --- 1. Postgres 資料庫設定 ---
POSTGRES_USER=aipe04
POSTGRES_PASSWORD=請在此填入您的安全密碼
POSTGRES_DB=aipe04

# --- 2. 後端 FastAPI 設定 ---
# 資料庫連線路徑 (注意：在 Docker Compose 內主機名稱必須使用服務名稱 postgres)
DATABASE_URL=postgresql://aipe04:請在此填入您的安全密碼@postgres:5432/aipe04
SECRET_KEY=請在此填入JWT加密金鑰
ENVIRONMENT=development

# --- 3. 前端 Vue / Vite 設定 (若有需要) ---
VITE_API_BASE_URL=/api
